{
  "name": "solana-paper-trader",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Autonomous Solana memecoin PAPER-trading bot. Simulation only: no wallet, no keys, no real trades.",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "node --disable-warning=ExperimentalWarning server/src/main.ts",
    "experiment:start": "node --disable-warning=ExperimentalWarning server/src/cli.ts start",
    "experiment:status": "node --disable-warning=ExperimentalWarning server/src/cli.ts status",
    "experiment:reset": "node --disable-warning=ExperimentalWarning server/src/cli.ts reset",
    "db:export": "node --disable-warning=ExperimentalWarning server/src/cli.ts export",
    "report": "node --disable-warning=ExperimentalWarning server/src/cli.ts report",
    "build": "vite build web",
    "dev:web": "vite web",
    "test": "node --disable-warning=ExperimentalWarning --test \"server/test/**/*.test.ts\"",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.0",
    "@types/node": "^24.0.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwindcss": "^4.1.0",
    "typescript": "^5.6.0",
    "vite": "^6.0.0"
  },
  "dependencies": {
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lightweight-charts": "5.0.9",
    "lucide-react": "^1.73.0",
    "radix-ui": "^1.8.1",
    "recharts": "^3.8.0",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.4.0"
  }
}
